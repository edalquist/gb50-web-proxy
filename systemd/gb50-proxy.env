# /etc/default/gb50-proxy
# Environment configuration file for Mitsubishi GB-50 REST Proxy & Web UI service.

# --- Mitsubishi Controller Connection ---
# IP address and port of the GB-50 / AG-150 / G-50 centralized controller
# Required: set the address for your installation before starting the service.
GB50_HOST=
GB50_PORT=80

# Telemetry polling interval in seconds (default: 3.0)
GB50_POLL_INTERVAL=3.0

# --- Web Proxy Server ---
# Bind host (0.0.0.0 listens on all interfaces) and HTTP port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- Persistence ---
# Path to SQLite database for RBAC users, active sessions, and layered schedules
GB50_DB_PATH=/var/lib/gb50/gb50_users.db

# Secret key for JWT token signing (auto-generated during installation)
# Leave blank to generate an ephemeral key, or configure a securely generated key.
GB50_JWT_SECRET=

# --- Security / CORS ---
# Allowed browser origins (comma-separated; defaults to local access)
# GB50_ALLOW_ORIGINS=http://localhost:8080,http://192.0.2.90

# --- Kiosk Mode & Local Display ---
# Options for GB50_KIOSK_AUTO_LOGIN: "viewer", "operator", "admin", or "disabled"
# When set to viewer or operator, physical connections originating directly from localhost (127.0.0.1)
# automatically authenticate into that role. Remote LAN connections always require explicit login.
GB50_KIOSK_AUTO_LOGIN=viewer

# Mouse cursor hiding for local kiosk display: "auto" (hide on idle), "always" (touchscreen), "never"
GB50_KIOSK_HIDE_CURSOR=auto

# Display energy saving / screen blanking (DPMS): "false" (always on), "true" (sleep after timeout)
GB50_KIOSK_DPMS=false
# GB50_KIOSK_DPMS_TIMEOUT=900
